VITE_API_BASE_URL=http://localhost:8080
# Set this to the real seeded lesson ID used by the student demo.
VITE_DEMO_LESSON_ID=9

# Backend database. DATABASE_URL may use Neon's -pooler endpoint; Flyway uses
# the direct endpoint for the same branch/database.
DATABASE_URL=jdbc:postgresql://YOUR_ENDPOINT-pooler.REGION.aws.neon.tech/math10?sslmode=require
DATABASE_DIRECT_URL=jdbc:postgresql://YOUR_ENDPOINT.REGION.aws.neon.tech/math10?sslmode=require
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Backend security and browser access.
JWT_SECRET=
JWT_EXPIRATION=3600000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FILE_STORAGE_PATH=./uploads/math10

# Staging seed accounts. Keep both switches false except during an intentional
# bootstrap; never commit real account passwords.
E2E_SEED_ENABLED=false
E2E_ADMIN_SEED_ENABLED=false
E2E_STUDENT_USERNAME=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_USERNAME=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_ADMIN_USERNAME=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Supabase Storage REST API, không dùng Supabase SDK.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Cloudflare R2 storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=math10-files
R2_PUBLIC_URL=
